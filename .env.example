# ---------------------------------------------------------------------------
# GrowthOS environment
# ---------------------------------------------------------------------------
# EVERYTHING BELOW IS OPTIONAL.
#
# GrowthOS runs its full demo with zero configuration. The recommendation
# engine, reasoning traces, creative generation, guardrails and outcome
# scenarios are all deterministic and run locally. An LLM is used only to
# re-phrase copy that the engine has already decided on.
#
# If no key is present, the LLM service layer reports itself unavailable and
# the product falls back to deterministic output automatically. No network
# access is required at any point during the demo.
# ---------------------------------------------------------------------------

# Provider: "anthropic" | "openai" | "none"  (default: none)
LLM_PROVIDER=none

# API key for the selected provider.
LLM_API_KEY=

# Optional model override.
# LLM_MODEL=claude-sonnet-5
